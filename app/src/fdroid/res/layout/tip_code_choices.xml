<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/tipCodeHow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/tip_code_how"
        android:textAppearance="@style/TextAppearance.WildInk.Detail" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tipChoice0"
            style="@style/Widget.WildInk.Block"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tipChoice1"
            style="@style/Widget.WildInk.Block"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="22sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tipChoice2"
            style="@style/Widget.WildInk.Block"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tipChoice3"
            style="@style/Widget.WildInk.Block"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="22sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/tipCodeField"
            style="@style/Widget.WildInk.EditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:hint="@string/tip_code_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tipCodeEnter"
            style="@style/Widget.WildInk.Block.Accent"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/tip_code_enter"
            android:textSize="20sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tipCodeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.WildInk.Detail" />

    <TextView
        android:id="@+id/tipExplain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.WildInk.Detail" />

    <TextView
        android:id="@+id/tipNotToday"
        style="@style/Widget.WildInk.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tip_not_today" />

    <TextView
        android:id="@+id/tipCodeTest"
        style="@style/Widget.WildInk.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/tip_code_test" />

</LinearLayout>
