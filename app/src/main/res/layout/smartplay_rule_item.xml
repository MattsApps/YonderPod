<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/rule_number"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bricolage_extrabold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:textColor="?attr/colorPrimary"
        android:textSize="56sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rule_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.WildInk.Label" />

            <ImageView
                android:id="@+id/rule_drag"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/smartplay_reorder"
                android:scaleType="center"
                app:srcCompat="?attr/dragview_background" />

            <ImageButton
                android:id="@+id/rule_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/smartplay_remove"
                app:srcCompat="@drawable/ic_close" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/rule_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp">

            <Spinner
                android:id="@+id/rule_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/rule_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/rule_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/rule_books_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/smartplay_books_not_in_all"
            android:textAppearance="@style/TextAppearance.WildInk.Detail"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="10dp"
            app:chipSpacingVertical="0dp">

            <TextView
                android:id="@+id/rule_except"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/rule_max_per_show"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="14sp" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

</LinearLayout>
