<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/customPreview"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/customPreviewWorld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.05"
            android:text="@string/world_podcasts"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/customPreviewPlay"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="end|top"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/symbol_play"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/customPreviewDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bricolage_semibold"
                android:text="@string/look_custom_preview_show"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/customPreviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bricolage_extrabold"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:text="@string/look_custom_preview_title"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="8dp">

                <View
                    android:id="@+id/customPreviewBar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical" />

                <View
                    android:id="@+id/customPreviewHandle"
                    android:layout_width="6dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="96dp" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <EditText
                android:id="@+id/customName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/look_custom_name"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="40" />

            <TextView
                android:id="@+id/customNudged"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/look_custom_background"
                android:textAppearance="@style/TextAppearance.WildInk.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/look_hue"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/customBackgroundHue"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/look_saturation"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/customBackgroundSaturation"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/look_lightness"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/customBackgroundLightness"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/look_custom_accent"
                android:textAppearance="@style/TextAppearance.WildInk.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/look_hue"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/customAccentHue"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/look_saturation"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/customAccentSaturation"
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/look_lightness"
                android:textAppearance="@style/TextAppearance.WildInk.Detail"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/customAccentLightness"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
