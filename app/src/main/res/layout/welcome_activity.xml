<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/welcomePager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/welcomeSkip"
            style="@style/Widget.WildInk.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_skip"
            android:textColor="?android:attr/textColorSecondary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/welcomeNext"
            style="@style/Widget.WildInk.Block.Accent"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center"
            android:minWidth="120dp"
            android:text="@string/welcome_next" />

    </LinearLayout>

</LinearLayout>
