<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <RadioGroup
            android:id="@+id/category_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/category_mode_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedule_mode_default" />

            <RadioButton
                android:id="@+id/category_mode_own"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedule_mode_own" />

            <RadioButton
                android:id="@+id/category_mode_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedule_mode_manual" />

        </RadioGroup>

        <include
            android:id="@+id/category_editor"
            layout="@layout/schedule_editor" />

        <Button
            android:id="@+id/category_download_settings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
