<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="@string/moving_bulk_hint"
        android:textAppearance="@style/TextAppearance.WildInk.Detail" />

    <EditText
        android:id="@+id/movingBulkText"
        style="@style/Widget.WildInk.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="top|start"
        android:hint="@string/moving_bulk_placeholder"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textUri"
        android:minLines="4" />

    <TextView
        android:id="@+id/movingBulkFind"
        style="@style/Widget.WildInk.Block"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/moving_bulk_find" />

</LinearLayout>
