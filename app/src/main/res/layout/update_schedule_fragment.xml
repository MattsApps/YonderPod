<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Widget.WildInk.PageTitle"
            android:text="@string/tune_updates" />

        <FrameLayout
            android:id="@+id/schedule_battery_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/wildink_block"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/schedule_battery_warning"
                    android:textAppearance="@style/TextAppearance.WildInk.Detail" />

                <Button
                    android:id="@+id/schedule_battery_fix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/schedule_battery_fix" />

            </LinearLayout>

        </FrameLayout>

        <de.danoeh.antennapod.ui.common.LowercaseTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/schedule_default_title"
            android:textAppearance="@style/TextAppearance.WildInk.SectionHeading" />

        <include
            android:id="@+id/schedule_default_editor"
            layout="@layout/schedule_editor" />

        <de.danoeh.antennapod.ui.common.LowercaseTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/schedule_categories_title"
            android:textAppearance="@style/TextAppearance.WildInk.SectionHeading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/schedule_categories_hint"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <LinearLayout
            android:id="@+id/schedule_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/schedule_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

    </LinearLayout>

</ScrollView>
