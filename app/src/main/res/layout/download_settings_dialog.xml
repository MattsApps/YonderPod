<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/download_list_order_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_list_order_label"
            android:textAppearance="@style/TextAppearance.WildInk.Label"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/download_list_order"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_mode_label"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <Spinner
            android:id="@+id/download_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/download_mode_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <TextView
            android:id="@+id/download_count_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_count_label"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <EditText
            android:id="@+id/download_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:id="@+id/download_keep_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_keep_label"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <EditText
            android:id="@+id/download_keep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_age_label"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <EditText
            android:id="@+id/download_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/download_allow_deletions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_allow_deletions" />

        <TextView
            android:id="@+id/download_allow_deletions_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_allow_deletions_summary"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_safety_note"
            android:textAppearance="@style/TextAppearance.WildInk.Label" />

        <LinearLayout
            android:id="@+id/download_show_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/download_mark_all"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_mark_all" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_mark_all_summary"
                android:textAppearance="@style/TextAppearance.WildInk.Label" />

            <Button
                android:id="@+id/download_clear_history"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/download_clear_history" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_clear_history_summary"
                android:textAppearance="@style/TextAppearance.WildInk.Label" />

            <Button
                android:id="@+id/download_defaults_link"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/download_defaults_link" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
