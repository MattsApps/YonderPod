<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/worldRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <include layout="@layout/world_names" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/world_play_to_edge">

        <TextView
            android:id="@+id/worldFrom"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/bricolage_semibold"
            android:lineSpacingMultiplier="1.1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/worldPlay"
            android:layout_width="@dimen/world_play_large"
            android:layout_height="@dimen/world_play_large"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/world_play_overhang"
            android:background="@drawable/wildink_play_circle"
            android:contentDescription="@string/play_label"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/worldPlayIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="38dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wildink_play"
                android:tint="?attr/colorOnPrimary" />

        </FrameLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/worldDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/worldShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.WildInk.DetailStrong" />

        <TextView
            android:id="@+id/worldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.98"
            android:maxLines="4"
            android:textAppearance="@style/TextAppearance.WildInk.PageTitle" />

        <TextView
            android:id="@+id/worldHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.WildInk.Detail"
            android:visibility="gone" />

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/worldProgressRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <de.danoeh.antennapod.smartplay.app.WildInkBar
            android:id="@+id/worldProgress"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/worldTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/bricolage_semibold"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/worldNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.WildInk.Detail" />

    <include layout="@layout/world_handle" />

</LinearLayout>
