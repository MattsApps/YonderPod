<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Widget.WildInk.PageTitle"
            android:text="@string/tune_controls" />

        <de.danoeh.antennapod.ui.common.LowercaseTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_buttons_title"
            android:textAppearance="@style/TextAppearance.WildInk.SectionHeading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/controls_buttons_hint"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <LinearLayout
            android:id="@+id/controls_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/controls_test_buttons"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controls_test_buttons" />

        <de.danoeh.antennapod.ui.common.LowercaseTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/controls_interruptions_title"
            android:textAppearance="@style/TextAppearance.WildInk.SectionHeading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/controls_notifications_label"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <Spinner
            android:id="@+id/controls_notifications"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_calls_note"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/controls_reconnect_label"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <Spinner
            android:id="@+id/controls_reconnect"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:id="@+id/controls_car"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_car_devices"
                android:textAppearance="@style/TextAppearance.WildInk.Detail" />

            <LinearLayout
                android:id="@+id/controls_car_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <de.danoeh.antennapod.ui.common.LowercaseTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/car_mode_title"
            android:textAppearance="@style/TextAppearance.WildInk.SectionHeading" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/controls_car_mode_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_mode_auto"
            android:textAppearance="@style/TextAppearance.WildInk.RowLabel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_mode_auto_summary"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <LinearLayout
            android:id="@+id/controls_car_mode_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/controls_car_mode_devices"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.WildInk.Detail" />

            <Button
                android:id="@+id/controls_car_mode_choose"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_mode_choose_devices" />

        </LinearLayout>

        <de.danoeh.antennapod.ui.common.LowercaseTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/controls_player_title"
            android:textAppearance="@style/TextAppearance.WildInk.SectionHeading" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/controls_fade_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_fade_in"
            android:textAppearance="@style/TextAppearance.WildInk.RowLabel" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/controls_keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_keep_screen_on"
            android:textAppearance="@style/TextAppearance.WildInk.RowLabel" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/controls_show_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_show_speed"
            android:textAppearance="@style/TextAppearance.WildInk.RowLabel" />

        <Button
            android:id="@+id/controls_advanced_toggle"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/controls_advanced" />

        <LinearLayout
            android:id="@+id/controls_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/controls_rewind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_rewind"
                android:textAppearance="@style/TextAppearance.WildInk.RowLabel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_rewind_summary"
                android:textAppearance="@style/TextAppearance.WildInk.Detail" />

            <LinearLayout
                android:id="@+id/controls_rewind_tiers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/controls_interruption_back"
                android:textAppearance="@style/TextAppearance.WildInk.Detail" />

            <Spinner
                android:id="@+id/controls_interruption_back"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
