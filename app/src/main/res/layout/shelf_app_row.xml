<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/shelfAppIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/shelfAppName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.WildInk.RowLabel" />

    <TextView
        android:id="@+id/shelfAppRemove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:fontFamily="@font/bricolage_extrabold"
        android:gravity="center"
        android:text="×"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/shelfAppHandle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:fontFamily="@font/bricolage_extrabold"
        android:gravity="center"
        android:text="≡"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="22sp" />

</LinearLayout>
