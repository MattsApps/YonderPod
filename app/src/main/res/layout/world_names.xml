<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="-8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.WildInk.Fit.Neighbour"
            android:id="@+id/worldLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textAppearance="@style/TextAppearance.WildInk.WorldNeighbour" />

        <TextView
            android:id="@+id/worldMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/yonder_wordmark"
            android:textAppearance="@style/TextAppearance.WildInk.Wordmark" />

        <TextView
            style="@style/Widget.WildInk.Fit.Neighbour"
            android:id="@+id/worldRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textAppearance="@style/TextAppearance.WildInk.WorldNeighbour" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tipNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/wildink_block"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tipNoteText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.WildInk.Detail" />

        <Button
            android:id="@+id/tipNoteOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tip_note_got_it" />

    </LinearLayout>

    <TextView
        style="@style/Widget.WildInk.Fit.WorldName"
        android:id="@+id/worldName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:accessibilityHeading="true"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.WildInk.WorldName" />

</LinearLayout>
