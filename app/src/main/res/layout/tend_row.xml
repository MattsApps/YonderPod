<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <FrameLayout
        android:id="@+id/rowArtBox"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/colorSurfaceContainerHigh">

        <TextView
            android:id="@+id/rowInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/bricolage_extrabold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/rowArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bricolage_semibold"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/rowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.WildInk.Detail"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/rowNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/bricolage_extrabold"
        android:textColor="?attr/colorPrimary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/rowSaved"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.WildInk.Detail" />

</LinearLayout>
