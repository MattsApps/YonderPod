<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_margin">

    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_wildink_bg" />

    <RelativeLayout
        android:id="@+id/widgetLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/playBox"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="-14dp"
            android:layout_marginTop="-14dp">

            <ImageView
                android:id="@+id/butPlayCircle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/play_label"
                android:src="@drawable/widget_wildink_corner_circle" />

            <ImageView
                android:id="@+id/butPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wildink_play_centred" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/playBox"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtvShow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="2"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/progressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgvProgress"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/txtvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtvSmartPlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/butRew"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@string/rewind_label"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/butFastForward"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@string/fast_forward_label"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/butSkip"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@string/skip_episode_label"
                android:paddingHorizontal="13dp"
                android:paddingVertical="9dp"
                android:src="@drawable/wildink_next" />

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
