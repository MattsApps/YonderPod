<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_margin">

    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_wildink_bg" />

    <LinearLayout
        android:id="@+id/widgetLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <FrameLayout
            android:id="@+id/playBox"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:layout_marginStart="-10dp">

            <ImageView
                android:id="@+id/butPlayCircle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/play_label"
                android:src="@drawable/widget_wildink_corner_circle_slim" />

            <ImageView
                android:id="@+id/butPlay"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="1dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wildink_play_centred" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/titleBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="2"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtvBehind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <ImageView
            android:id="@+id/butSkip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/skip_episode_label"
            android:padding="13dp"
            android:src="@drawable/wildink_next" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/slimLiveBox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="52dp"
        android:contentDescription="@string/live_pause_go_live_description"
        android:visibility="gone">

        <ImageView
            android:id="@+id/slimLiveCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/wildink_dot" />

        <TextView
            android:id="@+id/slimLiveText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/live_pause_go_live"
            android:textSize="9sp" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/slimStopBox"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/live_pause_stop_description"
        android:visibility="gone">

        <ImageView
            android:id="@+id/slimStopCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_wildink_corner_circle_slim_end" />

        <ImageView
            android:id="@+id/slimStop"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/wildink_stop_square" />

    </FrameLayout>

</FrameLayout>
